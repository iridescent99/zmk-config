#include <dt-bindings/zmk/pointing.h>

/*
 * A rotary detent is a discrete action, not a held mouse key. ZMK v0.3's
 * scroll behavior integrates velocity over its reporting period. At 125
 * units/second and an 8 ms period it emits one wheel unit per report; a
 * 12 ms tap allows one report, then releases before the second is due.
 * Keeping this short avoids a long release queue during quick rotation.
 */
&msc {
    trigger-period-ms = <8>;
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

/ {
    behaviors {
        sofle_encoder_scroll: sofle_encoder_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <12>;
            /* Clockwise scrolls down; counter-clockwise scrolls up. */
            bindings = <&msc MOVE_Y(-125)>, <&msc MOVE_Y(125)>;
        };
    };
};
